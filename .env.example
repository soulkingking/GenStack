# 应用
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# 认证（生产环境务必修改）
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# 数据库（SQLite 默认；可改为 PostgreSQL 等）
# 可选；不设则使用仓库根目录 data/app.db（由后端自动解析）
# DATABASE_URL=sqlite:////absolute/path/to/data/app.db

# CORS（开发时可设为 http://localhost:5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
