# 应用
APP_DEBUG=false

# 认证（预留配置，登录接口尚未实现；生产环境务必修改）
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# 数据库（SQLite 默认；可改为 PostgreSQL 等）
# 可选；不设则使用仓库根目录 data/app.db（由后端自动解析）
# DATABASE_URL=sqlite:////absolute/path/to/data/app.db

# CORS（开发时可设为 http://localhost:5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nacos 服务注册（默认关闭；启用后启动时注册实例、关闭时注销）
NACOS_ENABLED=true
NACOS_SERVER_ADDR=10.100.10.62:8848
NACOS_SERVICE_NAME=genstack
NACOS_NAMESPACE=genstack
NACOS_GROUP=DEFAULT_GROUP
# NACOS_USERNAME=
# NACOS_PASSWORD=
# 实例注册地址；IP 留空时自动探测本机对外地址
# NACOS_INSTANCE_IP=
# NACOS_INSTANCE_PORT=8000
